# Copy to .env for local PostgreSQL development. Never commit real secrets.
DATABASE_URL=jdbc:postgresql://localhost:5432/storage_desk
DATABASE_USERNAME=storage_app
DATABASE_PASSWORD=replace-with-a-long-random-password
DDL_AUTO=validate
H2_CONSOLE_ENABLED=false
THYMELEAF_CACHE=true
SESSION_COOKIE_SECURE=false
APP_DEMO_DATA_ENABLED=false
APP_DEMO_USERNAME=demo
APP_DEMO_PASSWORD=replace-only-if-demo-mode-is-enabled
FLYWAY_ENABLED=true
PORT=8080
